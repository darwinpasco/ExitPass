{
  "contractVersion": "1.0",
  "managementPrefix": "/v1/management-platform/fiscal-reporting/sites/{siteId}",
  "operatorPrefix": "/v1/ops/operator-console/fiscal-reporting/sites/{siteId}",
  "routes": [
    "GET /electronic-journal",
    "GET /electronic-journal/download",
    "GET /x-readings",
    "POST /x-readings",
    "GET /x-readings/{reportReference}/download?format=pdf|json (default: pdf)",
    "GET /z-readings",
    "POST /z-readings",
    "GET /z-readings/{reportReference}/download?format=pdf|json (default: pdf)",
    "POST /bir-sales-summaries",
    "GET /bir-sales-summaries/{summaryId}",
    "GET /bir-sales-summaries/{summaryId}/download?format=json|csv|pdf",
    "POST /annex-e/e1/workbooks",
    "GET /annex-e/e1/workbooks/current",
    "GET /annex-e/e1/workbooks/{workbookId}",
    "GET /annex-e/e1/workbooks/{workbookId}/download?format=xlsx|pdf",
    "GET /monthly-esales?calendarYear={year}&calendarMonth={month}",
    "GET /monthly-esales/download?calendarYear={year}&calendarMonth={month}&format=json|csv|pdf",
    "GET /audit-trail?from={timestamp}&to={timestamp}[&actionCode={code}][&actor={actor}][&result={result}][&reference={reference}]",
    "GET /audit-trail/download?from={timestamp}&to={timestamp}&format=pdf|csv|json[&actionCode={code}][&actor={actor}][&result={result}][&reference={reference}]"
  ],
  "routingFailures": ["missing_binding", "inactive_binding", "ambiguous_binding", "unavailable_pos", "invalid_period", "unauthorized_scope"],
  "zRequest": { "confirmClose": true, "periodSelectedByBrowser": false, "sequenceSelectedByBrowser": false },
  "downloadPassThrough": true,
  "correlationHeader": "X-Correlation-Id"
}
