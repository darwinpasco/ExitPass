{
  "contractVersion": "1.0",
  "route": "/operator-console/fiscal-reporting",
  "authorityBoundary": "Browser -> Central PMS -> operator effective Site -> canonical Site POS binding -> POS Server",
  "scope": "AUTHORIZED_OPERATOR_SITE_ONLY",
  "permissions": [
    "fiscal-reporting.ej.read",
    "fiscal-reporting.ej.export",
    "fiscal-reporting.x.read",
    "fiscal-reporting.x.generate",
    "fiscal-reporting.z.read",
    "fiscal-reporting.z.generate",
    "fiscal-reporting.annex-e1.known-zero.attest",
    "fiscal-reporting.annex-e1.correct"
  ],
  "zGeneration": { "separateFromRead": true, "explicitConfirmation": true, "warningRequired": true },
  "birSalesSummary": {
    "readPermission": "fiscal-reporting.z.read",
    "generatePermission": "fiscal-reporting.z.generate",
    "requiresCommittedZReading": true,
    "exports": ["json", "csv"],
    "annexE1Export": "xlsx"
  },
  "annexE1GovernedCorrection": {
    "knownZeroRoute": "/v1/ops/operator-console/fiscal-reporting/sites/{siteId}/annex-e/e1/known-zero-attestations",
    "workbookRoute": "/v1/ops/operator-console/fiscal-reporting/sites/{siteId}/annex-e/e1/workbooks",
    "knownZeroPermission": "fiscal-reporting.annex-e1.known-zero.attest",
    "correctionPermission": "fiscal-reporting.annex-e1.correct",
    "csrfRequired": true,
    "automaticAttestation": false,
    "automaticCorrectionGeneration": false
  },
  "browserCalculation": false,
  "browserArtifactGeneration": false,
  "developmentScenario": { "query": "operatorFiscalReportingScenario=ready", "productionIgnored": true }
}
