{
  "AllowedHosts": "*",
  "Security": { "MtlsEnabled": false },
  "InternalSecurity": {
    "Mtls": {
      "Enabled": true,
      "RequireClientCertificate": true,
      "TrustedClientThumbprints": [],
      "ServicePrincipalCredentials": []
    }
  },
  "CentralPms": {
    "GateCommandRecoveryWorker": {
      "Enabled": false,
      "InitialDelaySeconds": 30,
      "IntervalSeconds": 30,
      "StaleAfterSeconds": 300,
      "RetryDelaySeconds": 300
    }
  },
  "HumanAuthentication": {
    "Enabled": true,
    "OidcEnabled": false,
