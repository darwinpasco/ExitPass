{
  "AllowedHosts": "*",
  "Security": { "MtlsEnabled": false },
  "InternalSecurity": {
    "Mtls": {
      "Enabled": false,
      "RequireClientCertificate": true,
      "TrustedClientThumbprints": []
    }
  },
  "CentralPms": {
    "GateCommandRecoveryWorker": {
      "Enabled": false,
      "InitialDelaySeconds": 30,
      "IntervalSeconds": 30,
      "StaleAfterSeconds": 300,
      "RetryDelaySeconds": 300
    }
  },
  "HumanAuthentication": {
    "Enabled": true,
    "OidcEnabled": false,
    "AllowedWebOrigins": []
  },
  "ManagementPlatform": {
    "DashboardReporting": {
      "Enabled": false,
      "ProjectionStaleAfterMinutes": 15
    },
    "PosServerSalesInvoiceProfileAdministration": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiKey": "",
      "TimeoutSeconds": 10
    }
  }
}
