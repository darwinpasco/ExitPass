{
  "AllowedHosts": "*",
  "Security": { "MtlsEnabled": false },
  "InternalSecurity": {
    "Mtls": {
      "Enabled": false,
      "RequireClientCertificate": true,
      "TrustedClientThumbprints": []
    }
  },
  "CentralPms": {
    "GateCommandDispatchWorker": {
      "Enabled": false,
      "InitialDelaySeconds": 30,
      "IntervalSeconds": 30
    },
    "GateCommandRecoveryWorker": {
      "Enabled": false,
      "InitialDelaySeconds": 30,
      "IntervalSeconds": 30,
      "StaleAfterSeconds": 300,
      "RetryDelaySeconds": 300
    }
  }
}
