    "TimeoutSeconds": 10
  },
  "ManagementPlatform": {
    "DashboardReporting": {
      "Enabled": false,
      "ProjectionStaleAfterMinutes": 15,
      "PaymentReconciliation": {
        "Enabled": false
      },
      "FiscalExceptions": {
        "Enabled": false
      }
    },
    "PosServerSalesInvoiceProfileAdministration": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiKey": "",
      "TimeoutSeconds": 10
    }
  }
