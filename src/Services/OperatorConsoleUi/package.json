{
  "name": "exitpass-operator-console-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:authentication": "vitest run src/humanAuthentication.test.ts src/apiClient.authentication.test.ts src/OperatorConsoleAuthenticationShell.test.tsx",
    "proof:authentication": "powershell -ExecutionPolicy Bypass -File ./scripts/Invoke-OperatorConsoleHumanAuthenticationProof.ps1",
    "test:browser-smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/Invoke-OperatorConsoleOrdinanceBrowserSmoke.ps1",
    "test:browser-smoke:headed": "powershell -ExecutionPolicy Bypass -File ./scripts/Invoke-OperatorConsoleOrdinanceBrowserSmoke.ps1 -Headed",
    "test:browser-smoke:server": "powershell -ExecutionPolicy Bypass -File ./scripts/Invoke-OperatorConsoleOrdinanceBrowserSmoke.ps1 -ServerOnly",
    "test:browser-smoke:ui": "powershell -ExecutionPolicy Bypass -File ./scripts/Invoke-OperatorConsoleOrdinanceBrowserSmoke.ps1 -Ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
