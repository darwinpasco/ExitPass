meta {
  name: 01 Disabled harness rejected
  type: http
  seq: 1
}

post {
  url: {{gateIntegrationBaseUrl}}/v1/internal/hikcentral/sandbox/validate-gate-action
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "doorIndexCode": "{{sandboxDoorIndexCode}}",
    "controlType": "Open",
    "controlDirection": "Exit",
    "validationReason": "{{sandboxValidationReason}}",
    "requestedBy": "{{sandboxRequestedBy}}",
    "correlationId": "{{$guid}}",
    "confirmLiveAction": true
  }
}

tests {
  test("disabled harness is rejected without vendor execution", function () {
    expect(res.status).to.equal(409);
    expect(res.body.executed).to.equal(false);
    expect(res.body.resultCode).to.equal("HIKCENTRAL_SANDBOX_VALIDATION_DISABLED");
    expect(res.body.auditId).to.equal(null);
  });

  test("response does not expose secret-bearing values", function () {
    const text = JSON.stringify(res.body);
    expect(text).to.not.include("AppSecret");
    expect(text).to.not.include("X-Ca-Signature");
  });
}
