meta {
  name: 06 Missing validation key rejected
  type: http
  seq: 6
}

post {
  url: {{gateIntegrationBaseUrl}}/v1/internal/hikcentral/sandbox/validate-gate-action
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{$guid}}
  X-Service-Identity-Id: {{sandboxServiceIdentityId}}
}

body:json {
  {
    "doorIndexCode": "{{sandboxDoorIndexCode}}",
    "controlType": "Open",
    "controlDirection": "Exit",
    "validationReason": "{{sandboxValidationReason}}",
    "requestedBy": "{{sandboxRequestedBy}}",
    "correlationId": "{{$guid}}",
    "confirmLiveAction": true
  }
}

tests {
  test("missing validation key is rejected before vendor execution", function () {
    expect(res.status).to.equal(401);
    expect(res.body.executed).to.equal(false);
    expect(res.body.resultCode).to.equal("SANDBOX_VALIDATION_KEY_REQUIRED");
    expect(res.body.auditId).to.equal(null);
  });
}
