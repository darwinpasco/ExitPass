meta {
  name: 05 Unauthorized service identity rejected
  type: http
  seq: 5
}

post {
  url: {{gateIntegrationBaseUrl}}/v1/internal/hikcentral/sandbox/validate-gate-action
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{$guid}}
  X-Service-Identity-Id: {{sandboxUnauthorizedServiceIdentityId}}
  X-HikCentral-Sandbox-Validation-Key: {{sandboxValidationAccessKey}}
}

body:json {
  {
    "doorIndexCode": "{{sandboxDoorIndexCode}}",
    "controlType": "Open",
    "controlDirection": "Exit",
    "validationReason": "{{sandboxValidationReason}}",
    "requestedBy": "{{sandboxRequestedBy}}",
    "correlationId": "{{$guid}}",
    "confirmLiveAction": true
  }
}

tests {
  test("unauthorized service identity is rejected before vendor execution", function () {
    expect(res.status).to.equal(403);
    expect(res.body.executed).to.equal(false);
    expect(res.body.resultCode).to.equal("SERVICE_IDENTITY_NOT_ALLOWED");
    expect(res.body.auditId).to.equal(null);
  });
}
