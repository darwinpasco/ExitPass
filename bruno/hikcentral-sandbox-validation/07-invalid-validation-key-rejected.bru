meta {
  name: 07 Invalid validation key rejected
  type: http
  seq: 7
}

post {
  url: {{gateIntegrationBaseUrl}}/v1/internal/hikcentral/sandbox/validate-gate-action
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{$guid}}
  X-Service-Identity-Id: {{sandboxServiceIdentityId}}
  X-HikCentral-Sandbox-Validation-Key: {{sandboxInvalidValidationAccessKey}}
}

body:json {
  {
    "doorIndexCode": "{{sandboxDoorIndexCode}}",
    "controlType": "Open",
    "controlDirection": "Exit",
    "validationReason": "{{sandboxValidationReason}}",
    "requestedBy": "{{sandboxRequestedBy}}",
    "correlationId": "{{$guid}}",
    "confirmLiveAction": true
  }
}

tests {
  test("invalid validation key is rejected before vendor execution", function () {
    expect(res.status).to.equal(401);
    expect(res.body.executed).to.equal(false);
    expect(res.body.resultCode).to.equal("SANDBOX_VALIDATION_KEY_INVALID");
    expect(res.body.auditId).to.equal(null);
  });

  test("response does not echo the validation key", function () {
    expect(JSON.stringify(res.body)).to.not.include("{{sandboxInvalidValidationAccessKey}}");
  });
}
