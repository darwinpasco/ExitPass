meta {
  name: 63 Apply payable basis free duration policy blocked
  type: http
  seq: 63
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{validationId_freeDurationPolicy}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_verifiedLocal}}",
    "siteId": "{{policyResolutionSiteId_verifiedLocal}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_verifiedLocal}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-apply-free-duration-policy-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("FREE_DURATION persisted policy is not processed by VAT-exempt computation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.errorCode).to.equal("POLICY_BENEFIT_TYPE_NOT_SUPPORTED_FOR_PAYABLE_APPLICATION");
    expect(res.body.policyResolutionBasis).to.equal("LOCAL_ORDINANCE_APPLIED");
    expect(res.body.benefitType).to.equal("FREE_DURATION");
    expect(res.body.payableBasisApplicationId).to.equal(null);
  });
}
