meta {
  name: 38 Resolve policy PWD national fallback
  type: http
  seq: 38
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/resolve-policy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "entitlementType": "{{pwdEntitlementType}}",
    "idempotencyKey": "manual-policy-resolution-pwd-fallback-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("resolves PWD to RA 10754 national fallback without free parking", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.policyResolved).to.equal(true);
    expect(res.body.policyCode).to.equal("PH_RA10754_PWD_NATIONAL_FALLBACK");
    expect(res.body.policyResolutionBasis).to.equal("NATIONAL_LAW_FALLBACK");
    expect(res.body.entitlementType).to.equal("PWD");
    expect(res.body.nationalLawReference).to.equal("RA 10754");
    expect(res.body.benefitType).to.equal("STATUTORY_DISCOUNT_VAT_EXEMPT");
    expect(res.body.freeDurationMinutes).to.equal(null);
    expect(res.body.initialRateExempt).to.equal(false);
    expect(res.body.fullFeeExempt).to.equal(false);
    expect(res.body.policySnapshot).to.not.equal(null);
  });
}
