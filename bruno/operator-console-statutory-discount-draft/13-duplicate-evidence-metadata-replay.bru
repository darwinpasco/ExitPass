meta {
  name: 13 Duplicate evidence metadata replay
  type: http
  seq: 13
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "ticketReference": "{{ticketReference_allowed}}",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": true,
    "evidenceAccessIntent": "SUPERVISOR_REVIEW",
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test duplicate metadata-only evidence replay",
    "reasonCode": "MANUAL_TEST_DRAFT_EVIDENCE_METADATA",
    "idempotencyKey": "manual-statutory-draft-senior-evidence-replay-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("reuses existing draft and does not duplicate evidence metadata", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.draftAccepted).to.equal(true);
    expect(res.body.draftPersisted).to.equal(true);
    expect(res.body.reusedExistingDraft).to.equal(true);
    expect(res.body.evidenceRequired).to.equal(true);
    expect(res.body.evidenceReferenceCreated).to.equal(false);
    expect(res.body.evidenceReferenceId).to.not.equal(null);
  });
}
