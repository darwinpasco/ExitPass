meta {
  name: 95 Create payment attempt effective APPLIED tariff for finality
  type: http
  seq: 95
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{paymentFinalityIdempotencyKey}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{paymentFinalityParkingSessionId_applied}}",
    "tariffSnapshotId": "{{paymentFinalityTariffSnapshotId_appliedEffective}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("payment attempt is created or reused from the effective APPLIED tariff snapshot", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.paymentAttemptId).to.not.equal(null);
    expect(res.body.paymentProvider).to.equal(bru.getEnvVar("paymentMethodGcash"));
    expect(res.body.providerHandoff).to.not.equal(null);
    bru.setEnvVar("paymentFinalityPaymentAttemptId", res.body.paymentAttemptId);
  });
}
