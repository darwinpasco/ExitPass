meta {
  name: 162 Service-channel review discover WebPay pending
  type: http
  seq: 162
}

get {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/reviews/pending?sourceChannel=WEBPAY&page=1&pageSize=25
  body: none
  auth: none
}

headers {
  X-Correlation-Id: 77000000-0000-0000-0000-000000000762
  X-ExitPass-User-Id: {{userId_allowed}}
  X-ExitPass-Operator-Device-Binding-Id: {{operatorDeviceBindingId_allowed}}
  X-ExitPass-Operator-Shift-Id: {{operatorShiftId_allowed}}
  X-ExitPass-Site-Id: {{siteId_allowed}}
  X-ExitPass-Site-Group-Id: {{siteGroupId_allowed}}
  X-ExitPass-Permissions: operator-console.statutory-discounts.decision
}

tests {
  test("discovers WebPay pending service-channel review", function () {
    expect(res.status).to.equal(200);
    const commandId = bru.getEnvVar("sharedStatutoryWebPayPendingDecisionCommandId");
    expect(res.body.items.some(item =>
      item.statutoryDiscountDecisionCommandId === commandId &&
      item.sourceChannel === "WEBPAY" &&
      item.commandStatus === "AWAITING_REVIEW" &&
      item.decisionResultStatus === "NOT_DECIDED" &&
      item.reviewStatus === "PENDING_REVIEW")).to.equal(true);
  });
}
