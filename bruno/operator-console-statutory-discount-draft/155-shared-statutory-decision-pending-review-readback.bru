meta {
  name: 155 Shared statutory decision pending review readback
  type: http
  seq: 155
}

get {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions/{{sharedStatutoryWebPayPendingDecisionCommandId}}
  body: none
  auth: none
}

headers {
  X-Correlation-Id: 77000000-0000-0000-0000-000000000755
  X-ExitPass-Service-Identity-Id: {{sharedStatutoryDecisionWebPayServiceIdentityId}}
  X-ExitPass-Permissions: statutory-discounts.decision.read
}

tests {
  test("readback exposes pending-review posture", function () {
    expect(res.status).to.equal(200);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("sharedStatutoryWebPayPendingDecisionCommandId"));
    expect(res.body.commandStatus).to.equal("AWAITING_REVIEW");
    expect(res.body.clientResultStatus).to.equal("AWAITING_REVIEW");
    expect(res.body.decisionCommandStatus).to.equal("AWAITING_REVIEW");
    expect(res.body.decisionResultStatus).to.equal("NOT_DECIDED");
    expect(res.body.applicationRequested).to.equal(false);
    expect(res.body.applicationCommandStatus).to.equal("NOT_REQUESTED");
    expect(res.body.oneShotComplete).to.equal(false);
    expect(res.body.retryable).to.equal(false);
  });
}
