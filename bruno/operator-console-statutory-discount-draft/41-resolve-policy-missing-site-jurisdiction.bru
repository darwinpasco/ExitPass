meta {
  name: 41 Resolve policy missing site jurisdiction
  type: http
  seq: 41
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/resolve-policy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_missingJurisdiction}}",
    "siteId": "{{policyResolutionSiteId_missingJurisdiction}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_missingJurisdiction}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "entitlementType": "{{seniorEntitlementType}}",
    "idempotencyKey": "manual-policy-resolution-missing-jurisdiction-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("fails closed when site jurisdiction is missing", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.policyResolved).to.equal(false);
    expect(res.body.errorCode).to.equal("SITE_JURISDICTION_NOT_CONFIGURED");
    expect(res.body.policyCode).to.equal(null);
  });
}
