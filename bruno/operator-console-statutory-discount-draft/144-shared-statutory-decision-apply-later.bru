meta {
  name: 144 Shared statutory decision apply later
  type: http
  seq: 144
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-decision-apply-later
  X-Correlation-Id: {{sharedStatutoryDecisionCorrelationId}}
  X-ExitPass-User-Id: {{userId_allowed}}
  X-ExitPass-Permissions: statutory-discounts.decision.submit.operator-console
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000704",
    "sourceChannel": "OPERATOR_CONSOLE",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "{{ticketReference_allowed}}",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "evidenceCaptureRequested": false,
    "evidenceReferences": [],
    "actorUserId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "requesterAttestation": true,
    "attestationNotes": "Shared facade Bruno apply-later",
    "reasonCode": "MANUAL_SHARED_STATUTORY_DECISION",
    "decision": null,
    "decisionReasonCode": null,
    "reviewerUserId": null,
    "reviewerAttestation": false,
    "applyPayableBasis": true,
    "originalTariffSnapshotId": null
  }
}

tests {
  test("creates only the missing application stage for an existing approved decision", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("sharedStatutoryDecisionCommandId"));
    expect(res.body.semanticHashSourceVersion).to.equal("statutory-discount-decision:sha256:v2");
    expect(res.body.applicationRequested).to.equal(true);
    expect(res.body.applicationCommandStatus).to.equal("APPLIED");
    expect(res.body.applicationSemanticHashSourceVersion).to.equal("statutory-discount-payable-basis-application:sha256:v1");
    expect(res.body.statutoryDiscountPayableBasisApplicationCommandId).to.not.equal(null);
    expect(res.body.oneShotComplete).to.equal(true);
    bru.setEnvVar("sharedStatutoryPayableBasisApplicationCommandId", res.body.statutoryDiscountPayableBasisApplicationCommandId);
  });
}
