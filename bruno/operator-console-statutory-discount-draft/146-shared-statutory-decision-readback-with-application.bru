meta {
  name: 146 Shared statutory decision readback with application
  type: http
  seq: 146
}

get {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions/{{sharedStatutoryDecisionCommandId}}
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{sharedStatutoryDecisionCorrelationId}}
  X-ExitPass-User-Id: {{userId_allowed}}
  X-ExitPass-Permissions: statutory-discounts.decision.read
}

tests {
  test("returns separate decision and application state", function () {
    expect(res.status).to.equal(200);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("sharedStatutoryDecisionCommandId"));
    expect(res.body.decisionCommandStatus).to.equal("COMPLETED");
    expect(res.body.decisionResultStatus).to.equal("APPROVED");
    expect(res.body.applicationRequested).to.equal(true);
    expect(res.body.applicationCommandStatus).to.equal("APPLIED");
    expect(res.body.statutoryDiscountPayableBasisApplicationCommandId).to.equal(bru.getEnvVar("sharedStatutoryPayableBasisApplicationCommandId"));
    expect(res.body.oneShotComplete).to.equal(true);
  });
}
