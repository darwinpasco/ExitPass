meta {
  name: 117 Vendor resolve APPLIED basis for gate consume
  type: http
  seq: 117
}

post {
  url: {{vendorParkingBaseUrl}}/v1/vendor-parking/resolve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siteGroupId": "{{siteGroupId_allowed}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "vendorSystemId": "{{vendorSystemId_manual}}",
    "plateNumber": null,
    "ticketReference": "{{vendorResolveTicketReference_applied}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("vendor resolve exposes the APPLIED tariff as the gate consume payable basis", function () {
    expect(res.status).to.equal(200);
    expect(res.body.lookupOutcome).to.equal("resolved");
    expect(res.body.statutoryDiscountApplied).to.equal(true);
    expect(res.body.effectiveTariffSnapshotId).to.equal(res.body.appliedTariffSnapshotId);
    expect(res.body.originalTariffSnapshotId).to.equal(bru.getEnvVar("gateConsumeOriginalTariffSnapshotId"));
    expect(res.body.effectiveTariffSnapshotId).to.equal(bru.getEnvVar("gateConsumeTariffSnapshotId_appliedEffective"));
    expect(res.body.netPayableMinorUnits).to.equal(Number(bru.getEnvVar("gateConsumeAmountMinorUnits_appliedEffective")));
    expect(res.body.currency).to.equal(bru.getEnvVar("gateConsumeCurrencyCode"));

    bru.setEnvVar("gateConsumeParkingSessionId_applied", res.body.parkingSessionId);
    bru.setEnvVar("gateConsumeTariffSnapshotId_appliedEffective", res.body.effectiveTariffSnapshotId);
    bru.setEnvVar("gateConsumeOriginalTariffSnapshotId", res.body.originalTariffSnapshotId);
  });
}
