meta {
  name: 113 No-discount exit authorization baseline
  type: http
  seq: 113
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{exitAuthorizationNoDiscountIdempotencyKeyPaymentAttempt}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{exitAuthorizationNoDiscountParkingSessionId}}",
    "tariffSnapshotId": "{{exitAuthorizationNoDiscountTariffSnapshotId}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("no-discount payment attempt is created or reused for exit authorization", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.paymentAttemptId).to.not.equal(null);
    expect(res.body.paymentProvider).to.equal(bru.getEnvVar("paymentMethodGcash"));
    bru.setEnvVar("exitAuthorizationNoDiscountPaymentAttemptId", res.body.paymentAttemptId);
  });
}
