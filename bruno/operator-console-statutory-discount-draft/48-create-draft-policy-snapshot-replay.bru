meta {
  name: 48 Create draft policy snapshot replay
  type: http
  seq: 48
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_verifiedLocal}}",
    "siteId": "{{policyResolutionSiteId_verifiedLocal}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_verifiedLocal}}",
    "parkingSessionId": "{{draftPolicySnapshotVerifiedLocalId}}",
    "ticketReference": "MANUAL-DRAFT-POLICY-VERIFIED-LOCAL",
    "plateNumber": null,
    "entitlementType": "{{seniorEntitlementType}}",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test draft policy snapshot replay",
    "reasonCode": "MANUAL_TEST_DRAFT_POLICY_SNAPSHOT",
    "idempotencyKey": "manual-draft-policy-verified-local-replay-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("reuses existing draft and preserves stored policy snapshot fields", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(true);
    expect(res.body.draftPersisted).to.equal(true);
    expect(res.body.reusedExistingDraft).to.equal(true);
    expect(res.body.draftId).to.equal(bru.getEnvVar("draftPolicySnapshotReplayId"));
    expect(res.body.policyCode).to.equal("MANUAL_TEST_QC_VERIFIED_LOCAL_POLICY");
    expect(res.body.policyResolutionBasis).to.equal("LOCAL_ORDINANCE_APPLIED");
    expect(res.body.ordinanceReference).to.equal("MANUAL-QC-ORD-193");
    expect(res.body.policySnapshot).to.not.equal(null);
    expect(res.body.policySnapshot.policyCode).to.equal("MANUAL_TEST_QC_VERIFIED_LOCAL_POLICY");
    expect(res.body.policySnapshot.ordinanceReference).to.equal("MANUAL-QC-ORD-193");
  });
}
