meta {
  name: 36 Evidence required apply blocked
  type: http
  seq: 36
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_evidenceRequired}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "originalTariffSnapshotId": "{{originalTariffSnapshotId_allowed}}",
    "idempotencyKey": "manual-statutory-apply-evidence-required-blocked-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("evidence-required draft cannot be applied without approval and capture", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(["STATUTORY_DISCOUNT_NOT_APPROVED", "EVIDENCE_REQUIRED_NOT_CAPTURED"]).to.include(res.body.errorCode);
  });
}
