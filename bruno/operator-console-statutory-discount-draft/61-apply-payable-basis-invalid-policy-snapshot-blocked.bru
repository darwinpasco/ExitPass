meta {
  name: 61 Apply payable basis invalid policy snapshot blocked
  type: http
  seq: 61
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{validationId_invalidPolicySnapshot}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-apply-invalid-policy-snapshot-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("invalid persisted policy snapshot blocks apply", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_POLICY_SNAPSHOT_INVALID");
    expect(res.body.payableBasisApplicationId).to.equal(null);
  });
}
