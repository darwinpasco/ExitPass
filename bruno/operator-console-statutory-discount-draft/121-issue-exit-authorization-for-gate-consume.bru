meta {
  name: 121 Issue exit authorization for gate consume
  type: http
  seq: 121
}

post {
  url: {{internalExitAuthorizationBaseUrl}}/v1/internal/payment-attempts/{{gateConsumePaymentAttemptId}}/issue-exit-authorization
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{gateConsumeIdempotencyKeyIssue}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{gateConsumeParkingSessionId_applied}}",
    "requestedByUserId": "{{exitAuthorizationRequestedByUserId}}"
  }
}

tests {
  test("exit authorization is issued from the confirmed APPLIED tariff payment attempt for gate consume", function () {
    expect(res.status).to.equal(200);
    expect(res.body.exitAuthorizationId).to.not.equal(null);
    expect(res.body.paymentAttemptId).to.equal(bru.getEnvVar("gateConsumePaymentAttemptId"));
    expect(res.body.parkingSessionId).to.equal(bru.getEnvVar("gateConsumeParkingSessionId_applied"));
    expect(res.body.authorizationStatus).to.equal("ISSUED");
    expect(res.body.expirationTimestamp).to.not.equal(null);

    bru.setEnvVar("gateConsumeExitAuthorizationId", res.body.exitAuthorizationId);
  });
}
