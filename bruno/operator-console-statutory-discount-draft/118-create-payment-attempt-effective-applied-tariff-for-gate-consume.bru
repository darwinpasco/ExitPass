meta {
  name: 118 Create payment attempt effective APPLIED tariff for gate consume
  type: http
  seq: 118
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{gateConsumeIdempotencyKeyPaymentAttempt}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{gateConsumeParkingSessionId_applied}}",
    "tariffSnapshotId": "{{gateConsumeTariffSnapshotId_appliedEffective}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("payment attempt is created or reused from the APPLIED tariff snapshot for gate consume", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.paymentAttemptId).to.not.equal(null);
    expect(res.body.paymentProvider).to.equal(bru.getEnvVar("paymentMethodGcash"));
    expect(res.body.providerHandoff).to.not.equal(null);

    bru.setEnvVar("gateConsumePaymentAttemptId", res.body.paymentAttemptId);
  });
}
