meta {
  name: 158 Shared statutory decision service manual decision rejected
  type: http
  seq: 158
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-service-decision-rejected
  X-Correlation-Id: 77000000-0000-0000-0000-000000000758
  X-ExitPass-Service-Identity-Id: {{sharedStatutoryDecisionWebPayServiceIdentityId}}
  X-ExitPass-Permissions: statutory-discounts.decision.submit.webpay
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000758",
    "sourceChannel": "WEBPAY",
    "parkingSessionId": "77000000-0000-0000-0000-000000000758",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "WEBPAY-PENDING-REVIEW-DECISION",
    "plateNumber": null,
