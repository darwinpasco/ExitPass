}

tests {
  test("service channel manual decision fields are rejected", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("CENTRAL_PMS_OPERATOR_FIELDS_NOT_ALLOWED_FOR_CHANNEL");
    expect(res.body.clientResultStatus).to.equal("VALIDATION_FAILURE");
  });
}
