meta {
  name: 75 Apply payable basis access denied applied lifecycle
  type: http
  seq: 75
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{appliedLifecycleValidationId_ra9994}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_inactiveHrMapping}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_inactiveHrMapping}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-applied-lifecycle-access-denied-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("access denied prevents APPLIED lifecycle mutation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(false);
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
  });
}
