meta {
  name: 178 Shared statutory decision service application prohibited fields
  type: http
  seq: 178
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-service-application-prohibited-fields
  X-Correlation-Id: 77000000-0000-0000-0000-000000000778
  X-ExitPass-Service-Identity-Id: {{sharedStatutoryDecisionWebPayServiceIdentityId}}
  X-ExitPass-Permissions: statutory-discounts.decision.submit.webpay
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000778",
    "sourceChannel": "WEBPAY",
    "parkingSessionId": "77000000-0000-0000-0000-000000000750",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "WEBPAY-PENDING-REVIEW-001",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "evidenceCaptureRequested": false,
    "evidenceReferences": [],
    "actorUserId": null,
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "operatorShiftId": null,
    "requesterAttestation": true,
    "attestationNotes": "Reviewer/device fields remain prohibited",
    "reasonCode": null,
    "decision": "APPROVE",
    "decisionReasonCode": "ELIGIBLE",
    "reviewerUserId": "{{userId_allowed}}",
    "reviewerAttestation": true,
    "applyPayableBasis": true,
    "originalTariffSnapshotId": null
  }
}

tests {
  test("service-channel application intent cannot submit operator-only facts", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_CHANNEL_FIELD_PROHIBITED");
  });
}
