meta {
  name: 35 Apply payable basis validation not approved
  type: http
  seq: 35
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{applyValidationId}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "originalTariffSnapshotId": "{{originalTariffSnapshotId_allowed}}",
    "idempotencyKey": "manual-statutory-apply-validation-not-approved-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("blocks payable-basis application for unapproved validation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_NOT_APPROVED");
  });
}
