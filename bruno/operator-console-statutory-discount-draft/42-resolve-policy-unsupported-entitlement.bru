meta {
  name: 42 Resolve policy unsupported entitlement
  type: http
  seq: 42
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/resolve-policy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "entitlementType": "{{unsupportedEntitlementType}}",
    "idempotencyKey": "manual-policy-resolution-unsupported-entitlement-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns deterministic bad request for unsupported entitlement", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("INVALID_OPERATOR_CONSOLE_POLICY_RESOLUTION_REQUEST");
  });
}
