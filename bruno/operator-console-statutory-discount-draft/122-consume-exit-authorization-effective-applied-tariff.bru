meta {
  name: 122 Consume exit authorization effective APPLIED tariff
  type: http
  seq: 122
}

post {
  url: {{gateConsumeBaseUrl}}/v1/gate/authorizations/{{gateConsumeExitAuthorizationId}}/consume
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{gateConsumeCorrelationIdConsume}}
  X-Service-Identity-Id: {{gateConsumeRequestedByUserId}}
  X-Gate-Device-Id: {{gateConsumeGateDeviceId}}
}

body:json {
  {
    "requestedByUserId": "{{gateConsumeRequestedByUserId}}"
  }
}

tests {
  test("gate consume succeeds for the issued APPLIED tariff exit authorization", function () {
    expect(res.status).to.equal(200);
    expect(res.body.exitAuthorizationId).to.equal(bru.getEnvVar("gateConsumeExitAuthorizationId"));
    expect(res.body.authorizationStatus).to.equal("CONSUMED");
    expect(res.body.consumedAt).to.not.equal(null);
  });
}
