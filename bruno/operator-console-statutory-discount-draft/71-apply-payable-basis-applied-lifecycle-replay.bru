meta {
  name: 71 Apply payable basis applied lifecycle replay
  type: http
  seq: 71
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{appliedLifecycleValidationId_ra9994}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-applied-lifecycle-replay-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("replay returns same APPLIED application and tariff snapshot", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(true);
    expect(res.body.applicationPersisted).to.equal(true);
    expect(res.body.applicationStatus).to.equal("APPLIED");
    expect(res.body.alreadyApplied).to.equal(true);
    expect(res.body.payableBasisApplicationId).to.equal(bru.getEnvVar("appliedLifecycleApplicationId_ra9994"));
    expect(res.body.appliedTariffSnapshotId).to.equal(bru.getEnvVar("appliedLifecycleAppliedTariffSnapshotId_ra9994"));
    expect(res.body.policySnapshotUsed).to.equal(true);
  });
}
