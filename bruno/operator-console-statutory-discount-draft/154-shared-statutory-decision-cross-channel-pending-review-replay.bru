meta {
  name: 154 Shared statutory decision cross-channel pending review replay
  type: http
  seq: 154
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-cross-channel-pending-review
  X-Correlation-Id: 77000000-0000-0000-0000-000000000754
  X-ExitPass-Service-Identity-Id: 7d000000-0000-0000-0000-000000000007
  X-ExitPass-Permissions: statutory-discounts.decision.submit.assisted-payment-terminal
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000754",
    "sourceChannel": "ASSISTED_PAYMENT_TERMINAL",
    "parkingSessionId": "77000000-0000-0000-0000-000000000750",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "WEBPAY-PENDING-REVIEW-001",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "evidenceCaptureRequested": false,
    "evidenceReferences": [],
    "actorUserId": null,
    "operatorDeviceBindingId": null,
    "operatorShiftId": null,
    "requesterAttestation": true,
    "attestationNotes": "WebPay pending review intake",
    "reasonCode": null,
    "decision": null,
    "decisionReasonCode": null,
    "reviewerUserId": null,
    "reviewerAttestation": false,
    "applyPayableBasis": false,
    "originalTariffSnapshotId": null
  }
}

tests {
  test("cross-channel equivalent request resolves one decision", function () {
    expect(res.status).to.equal(200);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("sharedStatutoryWebPayPendingDecisionCommandId"));
    expect(res.body.decisionCommandStatus).to.equal("AWAITING_REVIEW");
    expect(res.body.decisionResultStatus).to.equal("NOT_DECIDED");
    expect(res.body.applicationCommandStatus).to.equal("NOT_REQUESTED");
  });
}
