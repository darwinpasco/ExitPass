meta {
  name: 18 Access denied prevents decision
  type: http
  seq: 18
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_approve}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_inactiveHrMapping}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_inactiveHrMapping}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test access denied decision",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-access-denied-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("denied access does not persist decision", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(false);
    expect(res.body.accessDecision).to.equal("DENIED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(false);
    expect(res.body.decisionPersisted).to.equal(false);
  });
}
