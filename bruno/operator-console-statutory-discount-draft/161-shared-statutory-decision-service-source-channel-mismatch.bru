meta {
  name: 161 Shared statutory decision service source-channel mismatch
  type: http
  seq: 161
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-service-channel-mismatch
  X-Correlation-Id: 77000000-0000-0000-0000-000000000761
  X-ExitPass-Service-Identity-Id: {{sharedStatutoryDecisionWebPayServiceIdentityId}}
  X-ExitPass-Permissions: statutory-discounts.decision.submit.webpay
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000761",
    "sourceChannel": "ASSISTED_PAYMENT_TERMINAL",
    "parkingSessionId": "77000000-0000-0000-0000-000000000761",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "WEBPAY-PENDING-REVIEW-MISMATCH",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "evidenceCaptureRequested": false,
    "evidenceReferences": [],
    "actorUserId": null,
    "operatorDeviceBindingId": null,
    "operatorShiftId": null,
    "requesterAttestation": true,
    "attestationNotes": "Source channel mismatch rejection",
    "reasonCode": null,
    "decision": null,
    "decisionReasonCode": null,
    "reviewerUserId": null,
    "reviewerAttestation": false,
    "applyPayableBasis": false,
    "originalTariffSnapshotId": null
  }
}

tests {
  test("request-body source channel mismatch is rejected", function () {
    expect(res.status).to.equal(403);
    expect(res.body.errorCode).to.equal("CENTRAL_PMS_SOURCE_CHANNEL_MISMATCH");
    expect(res.body.clientResultStatus).to.equal("VALIDATION_FAILURE");
  });
}
