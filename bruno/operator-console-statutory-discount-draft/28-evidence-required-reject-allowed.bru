meta {
  name: 28 Evidence required reject allowed
  type: http
  seq: 28
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_evidenceRequired}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "REJECT",
    "decisionReasonCode": "EVIDENCE_NOT_CAPTURED",
    "decisionNotes": "Manual smoke test evidence-required rejection",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-evidence-reject-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("evidence-required draft can be rejected", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("REJECTED");
    expect(res.body.decision).to.equal("REJECT");
    expect(res.body.decisionReasonCode).to.equal("EVIDENCE_NOT_CAPTURED");
  });
}
