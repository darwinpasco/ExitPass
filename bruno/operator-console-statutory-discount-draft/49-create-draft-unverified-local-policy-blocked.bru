meta {
  name: 49 Create draft unverified local policy blocked
  type: http
  seq: 49
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_unverifiedLocal}}",
    "siteId": "{{policyResolutionSiteId_unverifiedLocal}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_unverifiedLocal}}",
    "parkingSessionId": "{{draftPolicySnapshotUnverifiedLocalId}}",
    "ticketReference": "MANUAL-DRAFT-POLICY-UNVERIFIED-LOCAL",
    "plateNumber": null,
    "entitlementType": "{{seniorEntitlementType}}",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test draft policy snapshot unverified local blocked",
    "reasonCode": "MANUAL_TEST_DRAFT_POLICY_SNAPSHOT",
    "idempotencyKey": "manual-draft-policy-unverified-local-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("blocks draft creation for unverified local policy", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(false);
    expect(res.body.draftPersisted).to.equal(false);
    expect(res.body.draftId).to.equal(null);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_POLICY_UNVERIFIED");
  });
}
