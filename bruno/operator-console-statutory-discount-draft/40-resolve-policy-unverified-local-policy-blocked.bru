meta {
  name: 40 Resolve policy unverified local policy blocked
  type: http
  seq: 40
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/resolve-policy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_unverifiedLocal}}",
    "siteId": "{{policyResolutionSiteId_unverifiedLocal}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_unverifiedLocal}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "entitlementType": "{{seniorEntitlementType}}",
    "idempotencyKey": "manual-policy-resolution-unverified-local-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("does not auto-resolve unverified local policy", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.policyResolved).to.equal(false);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_POLICY_UNVERIFIED");
    expect(res.body.policyCode).to.equal(null);
    expect(res.body.statutoryDiscountPolicyId).to.equal(null);
  });
}
