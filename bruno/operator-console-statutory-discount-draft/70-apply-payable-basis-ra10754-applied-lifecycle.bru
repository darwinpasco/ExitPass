meta {
  name: 70 Apply payable basis RA10754 applied lifecycle
  type: http
  seq: 70
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{appliedLifecycleValidationId_ra10754}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-applied-lifecycle-ra10754-apply-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("applies RA10754 payable basis to final APPLIED lifecycle", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(true);
    expect(res.body.applicationPersisted).to.equal(true);
    expect(res.body.applicationStatus).to.equal("APPLIED");
    expect(res.body.alreadyApplied).to.equal(false);
    expect(res.body.appliedTariffSnapshotId).to.not.equal(null);
    expect(res.body.policySnapshotUsed).to.equal(true);
    expect(res.body.benefitType).to.equal("STATUTORY_DISCOUNT_VAT_EXEMPT");
    expect(res.body.nationalLawReference).to.equal("RA 10754");
    bru.setEnvVar("appliedLifecycleApplicationId_ra10754", res.body.payableBasisApplicationId);
    bru.setEnvVar("appliedLifecycleAppliedTariffSnapshotId_ra10754", res.body.appliedTariffSnapshotId);
  });
}
