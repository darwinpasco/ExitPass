meta {
  name: 137 Consume with missing service identity rejected
  type: http
  seq: 137
}

post {
  url: {{gateConsumeBaseUrl}}/v1/gate/authorizations/{{gateConsumeWrongGateFixtureExitAuthorizationId}}/consume
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{gateConsumeMissingServiceIdentityCorrelationId}}
  X-Gate-Device-Id: {{gateConsumeGateDeviceId}}
}

body:json {
  {
    "requestedByUserId": "{{gateConsumeRequestedByUserId}}"
  }
}

tests {
  test("missing service identity header is rejected before consume persistence", function () {
    expect(res.status).to.equal(401);
    expect(res.body.errorCode).to.equal("SERVICE_IDENTITY_REQUIRED");
  });
}
