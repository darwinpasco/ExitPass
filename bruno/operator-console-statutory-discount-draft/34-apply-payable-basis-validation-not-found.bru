meta {
  name: 34 Apply payable basis validation not found
  type: http
  seq: 34
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{validationId_notFound}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "originalTariffSnapshotId": "{{originalTariffSnapshotId_allowed}}",
    "idempotencyKey": "manual-statutory-apply-validation-not-found-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns deterministic validation-not-found response", function () {
    expect(res.status).to.equal(404);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_VALIDATION_NOT_FOUND");
  });
}
