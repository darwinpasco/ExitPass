meta {
  name: 29 Create draft for apply payable basis
  type: http
  seq: 29
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "ticketReference": "{{ticketReference_allowed}}",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test apply payable basis draft",
    "reasonCode": "MANUAL_TEST_APPLY_PAYABLE_BASIS",
    "idempotencyKey": "manual-statutory-apply-draft-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("creates requested draft for apply payable basis", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(true);
    expect(res.body.draftPersisted).to.equal(true);
    expect(res.body.validationStatus).to.equal("REQUESTED");
    expect(res.body.evidenceRequired).to.equal(false);
    expect(res.body.draftId).to.not.equal(null);
    bru.setEnvVar("applyDraftId", res.body.draftId);
    bru.setEnvVar("applyValidationId", res.body.draftId);
  });
}
