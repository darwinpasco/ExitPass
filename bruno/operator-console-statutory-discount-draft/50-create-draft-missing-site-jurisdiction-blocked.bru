meta {
  name: 50 Create draft missing site jurisdiction blocked
  type: http
  seq: 50
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_missingJurisdiction}}",
    "siteId": "{{policyResolutionSiteId_missingJurisdiction}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_missingJurisdiction}}",
    "parkingSessionId": "{{draftPolicySnapshotMissingJurisdictionId}}",
    "ticketReference": "MANUAL-DRAFT-POLICY-MISSING-JURISDICTION",
    "plateNumber": null,
    "entitlementType": "{{seniorEntitlementType}}",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test draft policy snapshot missing jurisdiction blocked",
    "reasonCode": "MANUAL_TEST_DRAFT_POLICY_SNAPSHOT",
    "idempotencyKey": "manual-draft-policy-missing-jurisdiction-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("blocks draft creation when session site has no jurisdiction", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(false);
    expect(res.body.draftPersisted).to.equal(false);
    expect(res.body.draftId).to.equal(null);
    expect(res.body.errorCode).to.equal("SITE_JURISDICTION_NOT_CONFIGURED");
  });
}
