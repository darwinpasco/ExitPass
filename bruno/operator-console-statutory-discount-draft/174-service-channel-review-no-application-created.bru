meta {
  name: 174 Service-channel review no application created
  type: http
  seq: 174
}

get {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions/{{sharedStatutoryWebPayPendingDecisionCommandId}}
  body: none
  auth: none
}

headers {
  X-Correlation-Id: 77000000-0000-0000-0000-000000000774
  X-ExitPass-Service-Identity-Id: {{sharedStatutoryDecisionWebPayServiceIdentityId}}
  X-ExitPass-Permissions: statutory-discounts.decision.read
}

tests {
  test("review completion did not create application", function () {
    expect(res.status).to.equal(200);
    expect(res.body.applicationRequested).to.equal(false);
    expect(res.body.applicationCommandStatus).to.equal("NOT_REQUESTED");
    expect(res.body.statutoryDiscountPayableBasisApplicationCommandId).to.equal(null);
    expect(res.body.appliedTariffSnapshotId).to.equal(null);
  });
}
