meta {
  name: 165 Service-channel review approve WebPay
  type: http
  seq: 165
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/reviews/{{sharedStatutoryWebPayPendingDecisionCommandId}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "APPROVE",
    "decisionReasonCode": "ELIGIBLE",
    "decisionNotes": "Service-channel pending review approved",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-service-channel-webpay-review-approve",
    "correlationId": "77000000-0000-0000-0000-000000000765"
  }
}

tests {
  test("approves same canonical WebPay-originated decision", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("sharedStatutoryWebPayPendingDecisionCommandId"));
    expect(res.body.currentValidationStatus).to.equal("APPROVED");
    expect(res.body.decision).to.equal("APPROVE");
  });
}
