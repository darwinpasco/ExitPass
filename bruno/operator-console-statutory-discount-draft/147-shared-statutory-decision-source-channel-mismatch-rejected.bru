meta {
  name: 147 Shared statutory decision source-channel mismatch rejected
  type: http
  seq: 147
}

post {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: manual-shared-statutory-decision-channel-mismatch
  X-Correlation-Id: {{sharedStatutoryDecisionCorrelationId}}
  X-ExitPass-User-Id: {{userId_allowed}}
  X-ExitPass-Permissions: statutory-discounts.decision.submit.operator-console
}

body:json {
  {
    "requestReference": "77000000-0000-0000-0000-000000000705",
    "sourceChannel": "WEBPAY",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "ticketReference": "{{ticketReference_allowed}}",
    "plateNumber": null,
    "entitlementType": "SENIOR_CITIZEN",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "evidenceCaptureRequested": false,
    "evidenceReferences": [],
    "actorUserId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "requesterAttestation": true,
    "attestationNotes": "Shared facade Bruno mismatch",
    "reasonCode": "MANUAL_SHARED_STATUTORY_DECISION",
    "decision": null,
    "decisionReasonCode": null,
    "reviewerUserId": null,
    "reviewerAttestation": false,
    "applyPayableBasis": false,
    "originalTariffSnapshotId": null
  }
}

tests {
  test("rejects request-body source channel impersonation", function () {
    expect(res.status).to.equal(403);
    expect(res.body.errorCode).to.equal("SOURCE_CHANNEL_MISMATCH");
    expect(res.body.clientResultStatus).to.equal("VALIDATION_FAILURE");
  });
}
