meta {
  name: 89 Create payment attempt stale original tariff rejected
  type: http
  seq: 89
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{paymentIdempotencyKey_staleRejected}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{paymentParkingSessionId_staleRejected}}",
    "tariffSnapshotId": "{{paymentTariffSnapshotId_originalSuperseded_stale}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("payment attempt rejects stale original tariff after APPLIED statutory discount", function () {
    expect(res.status).to.equal(409);
    expect(res.body.errorCode).to.equal("STALE_TARIFF_SNAPSHOT");
    expect(res.body.details.submitted_tariff_snapshot_id).to.equal(bru.getEnvVar("paymentTariffSnapshotId_originalSuperseded_stale"));
    expect(res.body.details.effective_tariff_snapshot_id).to.not.equal(null);
  });
}
