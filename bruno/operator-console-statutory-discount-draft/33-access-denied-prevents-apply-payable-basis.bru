meta {
  name: 33 Access denied prevents apply payable basis
  type: http
  seq: 33
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{applyValidationId}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_inactiveHrMapping}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_inactiveHrMapping}}",
    "originalTariffSnapshotId": "{{originalTariffSnapshotId_allowed}}",
    "idempotencyKey": "manual-statutory-apply-access-denied-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("denied access prevents payable-basis application", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(false);
    expect(res.body.accessDecision).to.equal("DENIED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.payableBasisApplicationId).to.equal(null);
  });
}
