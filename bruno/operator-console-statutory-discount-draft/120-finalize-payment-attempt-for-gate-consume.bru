meta {
  name: 120 Finalize payment attempt for gate consume
  type: http
  seq: 120
}

post {
  url: {{internalPaymentFinalizationBaseUrl}}/v1/internal/payment-attempts/{{gateConsumePaymentAttemptId}}/finalize
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{gateConsumeIdempotencyKeyFinalization}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "finalAttemptStatus": "CONFIRMED",
    "requestedBy": "central-pms-manual-smoke"
  }
}

tests {
  test("payment attempt is finalized as confirmed for gate consume", function () {
    expect(res.status).to.equal(200);
    expect(res.body.paymentAttemptId).to.equal(bru.getEnvVar("gateConsumePaymentAttemptId"));
    expect(res.body.attemptStatus).to.equal("CONFIRMED");
  });
}
