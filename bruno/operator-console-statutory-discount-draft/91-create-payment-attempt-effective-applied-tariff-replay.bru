meta {
  name: 91 Create payment attempt effective applied tariff replay
  type: http
  seq: 91
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{paymentIdempotencyKey_replay}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{paymentParkingSessionId_applied}}",
    "tariffSnapshotId": "{{paymentTariffSnapshotId_appliedEffective}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("payment attempt replay remains idempotent after applied tariff is consumed", function () {
    expect(res.status).to.equal(200);
    expect(res.body.wasReused).to.equal(true);
    expect(res.body.paymentAttemptId).to.equal(bru.getEnvVar("paymentAttemptId_appliedEffective"));
    expect(res.body.paymentProvider).to.equal(bru.getEnvVar("paymentMethodGcash"));
  });
}
