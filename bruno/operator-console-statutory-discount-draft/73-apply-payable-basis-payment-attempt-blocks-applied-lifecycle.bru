meta {
  name: 73 Apply payable basis payment attempt blocks applied lifecycle
  type: http
  seq: 73
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{validationId_paymentAttemptBlocked}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-applied-lifecycle-payment-attempt-blocked-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("payment attempt guardrail blocks APPLIED lifecycle", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(false);
    expect(res.body.applicationPersisted).to.equal(false);
    expect(res.body.errorCode).to.equal("PAYMENT_ATTEMPT_ALREADY_EXISTS");
    expect(res.body.appliedTariffSnapshotId).to.equal(null);
  });
}
