meta {
  name: 69 Approve RA10754 applied lifecycle draft
  type: http
  seq: 69
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{appliedLifecycleValidationId_ra10754}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test approval/replay for seeded RA10754 APPLIED lifecycle validation",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-applied-lifecycle-ra10754-approve-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("seeded RA10754 lifecycle validation is approved or approve replay is deterministic", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("APPROVED");
    expect(res.body.draftId).to.equal(bru.getEnvVar("appliedLifecycleValidationId_ra10754"));
  });
}
