meta {
  name: 22 Reject without reason
  type: http
  seq: 22
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_reject}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "REJECT",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test reject without reason",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-reject-without-reason-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("reject without reason is rejected", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("INVALID_OPERATOR_CONSOLE_STATUTORY_DISCOUNT_DECISION_REQUEST");
  });
}
