meta {
  name: 23 Decision draft not found
  type: http
  seq: 23
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_notFound}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test draft not found",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-not-found-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("draft not found returns deterministic envelope", function () {
    expect(res.status).to.equal(404);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(false);
    expect(res.body.errorCode).to.equal("DRAFT_NOT_FOUND");
  });
}
