tests {
  test("changed material facts conflict deterministically", function () {
    expect(res.status).to.equal(409);
    expect(res.body.clientResultStatus).to.equal("SEMANTIC_CONFLICT");
    expect(["IDEMPOTENCY_SEMANTIC_CONFLICT", "STATUTORY_DISCOUNT_DECISION_SEMANTIC_CONFLICT"]).to.include(res.body.errorCode);
    expect(res.body.retryable).to.equal(false);
  });
}
