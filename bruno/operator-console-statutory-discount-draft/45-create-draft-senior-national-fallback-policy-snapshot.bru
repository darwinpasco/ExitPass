meta {
  name: 45 Create draft Senior national fallback policy snapshot
  type: http
  seq: 45
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "parkingSessionId": "{{draftPolicySnapshotSeniorId}}",
    "ticketReference": "MANUAL-DRAFT-POLICY-SENIOR-FALLBACK",
    "plateNumber": null,
    "entitlementType": "{{seniorEntitlementType}}",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test draft policy snapshot Senior national fallback",
    "reasonCode": "MANUAL_TEST_DRAFT_POLICY_SNAPSHOT",
    "idempotencyKey": "manual-draft-policy-senior-fallback-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("persists Senior Citizen RA 9994 fallback policy context", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(true);
    expect(res.body.draftPersisted).to.equal(true);
    expect(res.body.statutoryDiscountPolicyId).to.not.equal(null);
    expect(res.body.resolvedJurisdictionId).to.not.equal(null);
    expect(res.body.policyResolutionBasis).to.equal("NATIONAL_LAW_FALLBACK");
    expect(res.body.policyCode).to.equal("PH_RA9994_SENIOR_CITIZEN_NATIONAL_FALLBACK");
    expect(res.body.nationalLawReference).to.equal("RA 9994");
    expect(res.body.benefitType).to.equal("STATUTORY_DISCOUNT_VAT_EXEMPT");
    expect(res.body.freeDurationMinutes).to.equal(null);
    expect(res.body.policySnapshot).to.not.equal(null);
    expect(res.body.policySnapshot.nationalLawReference).to.equal("RA 9994");
    expect(res.body.policySnapshot.initialRateExempt).to.equal(false);
    expect(res.body.policySnapshot.fullFeeExempt).to.equal(false);
  });
}
