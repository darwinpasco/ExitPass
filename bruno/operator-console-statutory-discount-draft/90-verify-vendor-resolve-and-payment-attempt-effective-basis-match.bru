meta {
  name: 90 Verify vendor resolve and payment attempt effective basis match
  type: http
  seq: 90
}

post {
  url: {{paymentAttemptsBaseUrl}}/v1/public/payment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{paymentIdempotencyKey_valid}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{paymentParkingSessionId_applied}}",
    "tariffSnapshotId": "{{paymentTariffSnapshotId_appliedEffective}}",
    "paymentProvider": "{{paymentMethodGcash}}"
  }
}

tests {
  test("payment attempt reuses the same effective basis returned by vendor resolve", function () {
    expect(res.status).to.equal(200);
    expect(res.body.wasReused).to.equal(true);
    expect(res.body.paymentAttemptId).to.equal(bru.getEnvVar("paymentAttemptId_appliedEffective"));
    expect(bru.getEnvVar("paymentTariffSnapshotId_appliedEffective")).to.not.equal(bru.getEnvVar("paymentTariffSnapshotId_originalSuperseded"));
  });
}
