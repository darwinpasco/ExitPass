meta {
  name: 44 Resolve policy site group mismatch
  type: http
  seq: 44
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/resolve-policy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{policyResolutionSiteGroupId_wrong}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "entitlementType": "{{seniorEntitlementType}}",
    "idempotencyKey": "manual-policy-resolution-site-group-mismatch-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("site group mismatch is denied before policy resolution", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(false);
    expect(res.body.accessDecision).to.equal("DENIED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.policyResolved).to.equal(false);
    expect(res.body.policyCode).to.equal(null);
    expect(res.body.statutoryDiscountPolicyId).to.equal(null);
  });
}
