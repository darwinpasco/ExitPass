meta {
  name: 31 Apply payable basis approved validation
  type: http
  seq: 31
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{applyValidationId}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "originalTariffSnapshotId": "{{originalTariffSnapshotId_allowed}}",
    "idempotencyKey": "manual-statutory-apply-payable-basis-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("applies approved validation to final APPLIED payable-basis lifecycle", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(true);
    expect(res.body.applicationPersisted).to.equal(true);
    expect(res.body.payableBasisApplicationId).to.not.equal(null);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("applyDecisionCommandId"));
    expect(res.body.statutoryDiscountPayableBasisApplicationCommandId).to.not.equal(null);
    expect(res.body.statutoryDiscountValidationId).to.equal(bru.getEnvVar("applyValidationId"));
    expect(res.body.parkingSessionId).to.equal(bru.getEnvVar("parkingSessionId_allowed"));
    expect(res.body.originalTariffSnapshotId).to.equal(bru.getEnvVar("originalTariffSnapshotId_allowed"));
    expect(res.body.applicationStatus).to.equal("APPLIED");
    expect(res.body.alreadyApplied).to.equal(false);
    expect(res.body.appliedTariffSnapshotId).to.not.equal(null);
    expect(res.body.grossAmountMinorUnits).to.equal(12500);
    expect(res.body.vatAmountMinorUnits).to.equal(1339);
    expect(res.body.vatExclusiveAmountMinorUnits).to.equal(11161);
    expect(res.body.statutoryDiscountAmountMinorUnits).to.equal(2232);
    expect(res.body.finalPayableAmountMinorUnits).to.equal(8929);
    expect(res.body.currencyCode).to.equal("PHP");
    bru.setEnvVar("applyPayableBasisApplicationId", res.body.payableBasisApplicationId);
    bru.setEnvVar("applyPayableBasisApplicationCommandId", res.body.statutoryDiscountPayableBasisApplicationCommandId);
  });
}
