meta {
  name: 112 Issue exit authorization unconfirmed payment rejected
  type: http
  seq: 112
}

post {
  url: {{internalExitAuthorizationBaseUrl}}/v1/internal/payment-attempts/{{exitAuthorizationUnconfirmedPaymentAttemptId}}/issue-exit-authorization
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{exitAuthorizationUnconfirmedIssueIdempotencyKey}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{exitAuthorizationParkingSessionId_applied}}",
    "requestedByUserId": "{{exitAuthorizationRequestedByUserId}}"
  }
}

tests {
  test("exit authorization rejects an unconfirmed payment attempt", function () {
    expect(res.status).to.equal(409);
    expect(res.body.errorCode).to.equal("PAYMENT_ATTEMPT_NOT_CONFIRMED");
  });
}
