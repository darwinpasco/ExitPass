meta {
  name: 148 Legacy decision canonical readback
  type: http
  seq: 148
}

get {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions/{{legacyDecisionApproveCommandId}}
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{$guid}}
  X-ExitPass-User-Id: {{userId_allowed}}
  X-ExitPass-Permissions: statutory-discounts.decision.read
}

tests {
  test("legacy decision is readable as canonical decision-v2 without application", function () {
    expect(res.status).to.equal(200);
    expect(res.body.statutoryDiscountDecisionCommandId).to.equal(bru.getEnvVar("legacyDecisionApproveCommandId"));
    expect(res.body.sourceChannel).to.equal("OPERATOR_CONSOLE");
    expect(res.body.decisionCommandStatus).to.equal("COMPLETED");
    expect(res.body.decisionResultStatus).to.equal("APPROVED");
    expect(res.body.applicationRequested).to.equal(false);
    expect(res.body.applicationCommandStatus).to.equal("NOT_REQUESTED");
    expect(res.body.oneShotComplete).to.equal(true);
  });
}
