meta {
  name: 25 Reject replay
  type: http
  seq: 25
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_reject}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "REJECT",
    "decisionReasonCode": "ID_NOT_VALID",
    "decisionNotes": "Manual smoke test rejection replay",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-reject-replay-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("rejection replay is deterministic", function () {
    expect(res.status).to.equal(200);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("REJECTED");
    expect(res.body.alreadyDecided).to.equal(true);
    expect(res.body.decisionChanged).to.equal(false);
  });
}
