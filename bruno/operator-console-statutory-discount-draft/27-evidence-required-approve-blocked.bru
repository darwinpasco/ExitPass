meta {
  name: 27 Evidence required approve blocked
  type: http
  seq: 27
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_evidenceRequired}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test evidence-required approval block",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-evidence-approve-blocked-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("evidence-required approval is blocked until evidence is captured", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(false);
    expect(res.body.decisionPersisted).to.equal(false);
    expect(res.body.currentValidationStatus).to.equal("REQUESTED");
    expect(res.body.errorCode).to.equal("EVIDENCE_REQUIRED_NOT_CAPTURED");
  });
}
