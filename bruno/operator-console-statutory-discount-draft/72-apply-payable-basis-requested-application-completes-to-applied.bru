meta {
  name: 72 Apply payable basis requested application completes to applied
  type: http
  seq: 72
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{validationId_requestedApplication}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-applied-lifecycle-requested-complete-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("existing REQUESTED application completes to APPLIED", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(true);
    expect(res.body.applicationPersisted).to.equal(true);
    expect(res.body.applicationStatus).to.equal("APPLIED");
    expect(res.body.appliedTariffSnapshotId).to.not.equal(null);
    expect(res.body.alreadyApplied).to.equal(false);
  });
}
