meta {
  name: 116 Issue no-discount exit authorization baseline
  type: http
  seq: 116
}

post {
  url: {{internalExitAuthorizationBaseUrl}}/v1/internal/payment-attempts/{{exitAuthorizationNoDiscountPaymentAttemptId}}/issue-exit-authorization
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{exitAuthorizationNoDiscountIdempotencyKeyIssue}}
  X-Correlation-Id: {{$guid}}
}

body:json {
  {
    "parkingSessionId": "{{exitAuthorizationNoDiscountParkingSessionId}}",
    "requestedByUserId": "{{exitAuthorizationRequestedByUserId}}"
  }
}

tests {
  test("no-discount exit authorization is issued from the confirmed payment attempt", function () {
    expect(res.status).to.equal(200);
    expect(res.body.exitAuthorizationId).to.not.equal(null);
    expect(res.body.paymentAttemptId).to.equal(bru.getEnvVar("exitAuthorizationNoDiscountPaymentAttemptId"));
    expect(res.body.parkingSessionId).to.equal(bru.getEnvVar("exitAuthorizationNoDiscountParkingSessionId"));
    expect(res.body.authorizationStatus).to.equal("ISSUED");
    bru.setEnvVar("exitAuthorizationNoDiscountId", res.body.exitAuthorizationId);
  });
}
