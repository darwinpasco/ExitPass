meta {
  name: 24 Approve replay
  type: http
  seq: 24
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_approve}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test approval replay",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-approve-replay-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("approval replay is deterministic", function () {
    expect(res.status).to.equal(200);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("APPROVED");
    expect(res.body.alreadyDecided).to.equal(true);
    expect(res.body.decisionChanged).to.equal(false);
  });
}
