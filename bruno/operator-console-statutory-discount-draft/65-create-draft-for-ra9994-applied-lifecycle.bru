meta {
  name: 65 Create draft for RA9994 applied lifecycle
  type: http
  seq: 65
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "parkingSessionId": "{{draftPolicySnapshotSeniorId}}",
    "ticketReference": "MANUAL-DRAFT-POLICY-SENIOR-FALLBACK",
    "plateNumber": null,
    "entitlementType": "{{seniorEntitlementType}}",
    "idDocumentType": "SENIOR_CITIZEN_ID",
    "issuingAuthority": "OSCA",
    "expiryDate": null,
    "maskedIdReference": "{{seniorMaskedIdReference}}",
    "entitlementFingerprint": null,
    "evidenceCaptureRequested": false,
    "evidenceAccessIntent": null,
    "operatorAttestation": true,
    "attestationNotes": "Manual smoke test create draft before RA9994 APPLIED lifecycle coverage",
    "reasonCode": "MANUAL_TEST_APPLIED_LIFECYCLE_RA9994",
    "idempotencyKey": "manual-applied-lifecycle-ra9994-draft-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("creates Senior Citizen draft with RA9994 VAT-exempt policy snapshot", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.draftAccepted).to.equal(true);
    expect(res.body.draftPersisted).to.equal(true);
    expect(res.body.policySnapshot).to.not.equal(null);
    expect(res.body.benefitType).to.equal("STATUTORY_DISCOUNT_VAT_EXEMPT");
    expect(res.body.nationalLawReference).to.equal("RA 9994");
    bru.setEnvVar("appliedLifecycleDraftId_ra9994", res.body.draftId);
  });
}
