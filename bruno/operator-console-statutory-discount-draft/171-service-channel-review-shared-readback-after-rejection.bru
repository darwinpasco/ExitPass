meta {
  name: 171 Service-channel review shared readback after rejection
  type: http
  seq: 171
}

get {
  url: {{centralPmsBaseUrl}}/v1/statutory-discounts/decisions/{{sharedStatutoryAptPendingDecisionCommandId}}
  body: none
  auth: none
}

headers {
  X-Correlation-Id: 77000000-0000-0000-0000-000000000771
  X-ExitPass-Service-Identity-Id: 7d000000-0000-0000-0000-000000000007
  X-ExitPass-Permissions: statutory-discounts.decision.read
}

tests {
  test("shared readback returns rejection and no application", function () {
    expect(res.status).to.equal(200);
    expect(res.body.decisionCommandStatus).to.equal("COMPLETED");
    expect(res.body.decisionResultStatus).to.equal("REJECTED");
    expect(res.body.applicationRequested).to.equal(false);
    expect(res.body.applicationCommandStatus).to.equal("NOT_REQUESTED");
  });
}
