meta {
  name: 132 Consume expired exit authorization rejected
  type: http
  seq: 132
}

post {
  url: {{gateConsumeBaseUrl}}/v1/gate/authorizations/{{gateConsumeExpiredExitAuthorizationId}}/consume
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: {{gateConsumeExpiredCorrelationId}}
  X-Service-Identity-Id: {{gateConsumeRequestedByUserId}}
  X-Gate-Device-Id: {{gateConsumeGateDeviceId}}
}

body:json {
  {
    "requestedByUserId": "{{gateConsumeRequestedByUserId}}"
  }
}

tests {
  test("expired issued exit authorization is rejected before consume persistence", function () {
    expect(res.status).to.equal(409);
    expect(res.body.errorCode).to.equal("EXIT_AUTHORIZATION_EXPIRED");
  });
}
