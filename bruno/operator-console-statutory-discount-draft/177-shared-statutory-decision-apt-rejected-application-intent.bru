tests {
  test("rejected decision cannot create application", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("STATUTORY_DISCOUNT_DECISION_NOT_APPROVED");
    expect(res.body.clientResultStatus).to.equal("REJECTED_OR_NON_APPROVED");
    expect(res.body.retryable).to.equal(false);
  });
}
