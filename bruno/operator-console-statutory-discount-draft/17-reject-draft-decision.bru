meta {
  name: 17 Reject draft decision
  type: http
  seq: 17
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{draftId_reject}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "REJECT",
    "decisionReasonCode": "ID_NOT_VALID",
    "decisionNotes": "Manual smoke test rejection decision",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-decision-reject-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("rejects requested draft", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("REJECTED");
    expect(res.body.decision).to.equal("REJECT");
    expect(res.body.decisionReasonCode).to.equal("ID_NOT_VALID");
    expect(res.body.decisionChanged).to.equal(true);
    expect(res.body.alreadyDecided).to.equal(false);
  });
}
