meta {
  name: 55 Apply payable basis RA9994 policy snapshot
  type: http
  seq: 55
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{policySnapshotApplyValidationId_ra9994}}/apply-payable-basis
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{policyResolutionOperatorDeviceBindingId_nationalFallback}}",
    "siteId": "{{policyResolutionSiteId_nationalFallback}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{policyResolutionOperatorShiftId_nationalFallback}}",
    "originalTariffSnapshotId": null,
    "idempotencyKey": "manual-apply-policy-ra9994-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("applies payable basis using persisted RA9994 policy snapshot", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.applicationAccepted).to.equal(true);
    expect(res.body.applicationPersisted).to.equal(true);
    expect(res.body.policySnapshotUsed).to.equal(true);
    expect(res.body.statutoryDiscountPolicyId).to.not.equal(null);
    expect(res.body.policyResolutionBasis).to.equal("NATIONAL_LAW_FALLBACK");
    expect(res.body.policyCode).to.equal("PH_RA9994_SENIOR_CITIZEN_NATIONAL_FALLBACK");
    expect(res.body.benefitType).to.equal("STATUTORY_DISCOUNT_VAT_EXEMPT");
    expect(res.body.nationalLawReference).to.equal("RA 9994");
    expect(res.body.applicationStatus).to.equal("REQUESTED");
    expect(res.body.appliedTariffSnapshotId).to.equal(null);
    bru.setEnvVar("policySnapshotApplyApplicationId_ra9994", res.body.payableBasisApplicationId);
  });
}
