meta {
  name: 30 Approve draft for apply payable basis
  type: http
  seq: 30
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/statutory-discounts/{{applyDraftId}}/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "decision": "APPROVE",
    "decisionReasonCode": null,
    "decisionNotes": "Manual smoke test approval for payable basis application",
    "reviewerAttestation": true,
    "idempotencyKey": "manual-statutory-apply-approve-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("approves draft for payable basis application", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.decisionAccepted).to.equal(true);
    expect(res.body.decisionPersisted).to.equal(true);
    expect(res.body.currentValidationStatus).to.equal("APPROVED");
    expect(res.body.draftId).to.equal(bru.getEnvVar("applyDraftId"));
    expect(res.body.statutoryDiscountDecisionCommandId).to.not.equal(null);
    bru.setEnvVar("applyValidationId", res.body.draftId);
    bru.setEnvVar("applyDecisionCommandId", res.body.statutoryDiscountDecisionCommandId);
  });
}
