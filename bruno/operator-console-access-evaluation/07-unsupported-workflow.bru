meta {
  name: 07 Unsupported workflow
  type: http
  seq: 7
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/access/evaluate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "workflowCode": "UNSUPPORTED_WORKFLOW",
    "controlledActionCode": "START_WORKFLOW",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "evidenceAccessIntent": null,
    "idempotencyKey": "manual-unsupported-workflow-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted DENIED response with unsupported workflow reason", function () {
    expect(res.status).to.equal(200);
    expect(res.body.allowed).to.equal(false);
    expect(res.body.decision).to.equal("DENIED");
    expect(res.body.persisted).to.equal(true);
    expect(res.body.evaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.denialReasons).to.include("WORKFLOW_NOT_SUPPORTED");
  });
}
