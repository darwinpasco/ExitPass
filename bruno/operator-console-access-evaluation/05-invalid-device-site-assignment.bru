meta {
  name: 05 Invalid device site assignment
  type: http
  seq: 5
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/access/evaluate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_invalidAssignment}}",
    "siteGroupId": "{{siteGroupId_invalidAssignment}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "workflowCode": "STATUTORY_DISCOUNT_VALIDATION",
    "controlledActionCode": "START_WORKFLOW",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "evidenceAccessIntent": null,
    "idempotencyKey": "manual-invalid-assignment-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted DENIED response with device site assignment reason", function () {
    expect(res.status).to.equal(200);
    expect(res.body.allowed).to.equal(false);
    expect(res.body.decision).to.equal("DENIED");
    expect(res.body.persisted).to.equal(true);
    expect(res.body.evaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.denialReasons).to.satisfy(function (reasons) {
      return reasons.includes("DEVICE_SITE_ASSIGNMENT_NOT_FOUND") || reasons.includes("DEVICE_SITE_ASSIGNMENT_INVALID");
    });
  });
}
