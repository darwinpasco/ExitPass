meta {
  name: 02 Missing or inactive HR mapping
  type: http
  seq: 2
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/access/evaluate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_inactiveHrMapping}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_inactiveHrMapping}}",
    "workflowCode": "STATUTORY_DISCOUNT_VALIDATION",
    "controlledActionCode": "START_WORKFLOW",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "evidenceAccessIntent": null,
    "idempotencyKey": "manual-missing-hr-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted DENIED response with HR mapping reason", function () {
    expect(res.status).to.equal(200);
    expect(res.body.allowed).to.equal(false);
    expect(res.body.decision).to.equal("DENIED");
    expect(res.body.persisted).to.equal(true);
    expect(res.body.evaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.denialReasons).to.satisfy(function (reasons) {
      return reasons.includes("HR_IDENTITY_MAPPING_NOT_FOUND") || reasons.includes("HR_IDENTITY_MAPPING_INACTIVE");
    });
  });
}
