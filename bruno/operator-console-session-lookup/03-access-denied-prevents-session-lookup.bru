meta {
  name: 03 Access denied prevents session lookup
  type: http
  seq: 3
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/sessions/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_inactiveHrMapping}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_inactiveHrMapping}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "ticketReference": null,
    "plateNumber": null,
    "lookupMode": "PARKING_SESSION_ID",
    "idempotencyKey": "manual-session-lookup-access-denied-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted DENIED access with no session details", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(false);
    expect(res.body.accessDecision).to.equal("DENIED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.accessEvaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.accessDenialReasons).to.include("HR_IDENTITY_MAPPING_INACTIVE");
    expect(res.body.sessionFound).to.equal(false);
    expect(res.body.parkingSessionId).to.equal(null);
    expect(res.body.ticketReference).to.equal(null);
    expect(res.body.plateNumber).to.equal(null);
  });
}
