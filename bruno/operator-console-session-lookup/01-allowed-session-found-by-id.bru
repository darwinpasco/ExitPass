meta {
  name: 01 Allowed session found by parking session ID
  type: http
  seq: 1
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/sessions/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "ticketReference": null,
    "plateNumber": null,
    "lookupMode": "PARKING_SESSION_ID",
    "idempotencyKey": "manual-session-lookup-by-id-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted ALLOWED access and session details", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.accessEvaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.sessionFound).to.equal(true);
    expect(res.body.sessionEligible).to.equal(true);
    expect(res.body.parkingSessionId).to.equal(bru.getEnvVar("parkingSessionId_allowed"));
    expect(res.body.sessionStatus).to.equal("ACTIVE");
  });
}
