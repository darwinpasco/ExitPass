meta {
  name: 06 Allowed session not found
  type: http
  seq: 6
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/sessions/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": "{{parkingSessionId_notFound}}",
    "ticketReference": null,
    "plateNumber": null,
    "lookupMode": "PARKING_SESSION_ID",
    "idempotencyKey": "manual-session-lookup-not-found-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns persisted access evaluation and not-found session envelope", function () {
    expect(res.status).to.equal(404);
    expect(res.body.accessAllowed).to.equal(true);
    expect(res.body.accessDecision).to.equal("ALLOWED");
    expect(res.body.accessPersisted).to.equal(true);
    expect(res.body.accessEvaluationId).to.not.equal("00000000-0000-0000-0000-000000000000");
    expect(res.body.sessionFound).to.equal(false);
    expect(res.body.ineligibilityReason).to.equal("SESSION_NOT_FOUND");
  });
}
