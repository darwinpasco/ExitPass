meta {
  name: 05 Unsupported lookup mode
  type: http
  seq: 5
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/sessions/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": "{{parkingSessionId_allowed}}",
    "ticketReference": null,
    "plateNumber": null,
    "lookupMode": "PLATE",
    "idempotencyKey": "manual-session-lookup-unsupported-mode-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns deterministic unsupported lookup mode error", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("INVALID_OPERATOR_CONSOLE_SESSION_LOOKUP_REQUEST");
    expect(res.body.message).to.include("LookupMode must be PARKING_SESSION_ID or TICKET_REFERENCE");
  });
}
