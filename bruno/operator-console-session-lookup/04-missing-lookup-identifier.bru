meta {
  name: 04 Missing lookup identifier
  type: http
  seq: 4
}

post {
  url: {{centralPmsBaseUrl}}/v1/ops/operator-console/sessions/lookup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{userId_allowed}}",
    "operatorDeviceBindingId": "{{operatorDeviceBindingId_allowed}}",
    "siteId": "{{siteId_allowed}}",
    "siteGroupId": "{{siteGroupId_allowed}}",
    "operatorShiftId": "{{operatorShiftId_allowed}}",
    "parkingSessionId": null,
    "ticketReference": null,
    "plateNumber": null,
    "lookupMode": null,
    "idempotencyKey": "manual-session-lookup-missing-id-{{$guid}}",
    "correlationId": "{{$guid}}"
  }
}

tests {
  test("returns deterministic validation error", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errorCode).to.equal("INVALID_OPERATOR_CONSOLE_SESSION_LOOKUP_REQUEST");
    expect(res.body.message).to.include("ParkingSessionId or TicketReference");
  });
}
