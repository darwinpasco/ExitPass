# HikCentral vendor session projection live UAT environment template.
# Copy values into a local shell, deployment secret store, or approved UAT configuration channel.
# Do not commit real HikCentral credentials or local database passwords.

# Central PMS database.
ConnectionStrings__MainDatabase=Host=<postgres-host>;Port=5432;Database=<database>;Username=<username>;Password=<secret>

# Select the live HikCentral Vendor PMS adapter for Central PMS.
CentralPms__VendorPms__Provider=HikCentral
CentralPms__VendorPms__HikCentral__BaseUrl=https://<hikcentral-host>
CentralPms__VendorPms__HikCentral__AppKey=<hikcentral-app-key>
CentralPms__VendorPms__HikCentral__AppSecret=<hikcentral-app-secret>
CentralPms__VendorPms__HikCentral__UserId=exitpass-adapter

# Projection scheduler UAT flags.
# Enable only in the UAT process that should run the single centralized scheduler.
CentralPms__VendorSessionProjections__SchedulerEnabled=true
CentralPms__VendorSessionProjections__DefaultPollIntervalSeconds=300
CentralPms__VendorSessionProjections__DefaultLookbackWindowMinutes=180
CentralPms__VendorSessionProjections__DefaultPageSize=100
CentralPms__VendorSessionProjections__MaxParallelSiteJobs=2
CentralPms__VendorSessionProjections__StartupDelaySeconds=30
CentralPms__VendorSessionProjections__SchedulerScanIntervalSeconds=30
CentralPms__VendorSessionProjections__MaxPagesPerRun=20
CentralPms__VendorSessionProjections__MaxProjectionAgeMinutes=60
CentralPms__VendorSessionProjections__FailingFailureCountThreshold=3

# Keep degraded resolve fallback disabled during scheduler-only UAT unless a separate guarded fallback test is approved.
CentralPms__VendorSessionProjections__DegradedResolveFallbackEnabled=false

# Manual request placeholders; these are not service configuration keys.
EXITPASS_CENTRAL_PMS_BASE_URL=https://<central-pms-host>
HIKCENTRAL_PROJECTION_UAT_SITE_ID=<site-id>
HIKCENTRAL_PROJECTION_UAT_SITE_GROUP_ID=<site-group-id>
HIKCENTRAL_PROJECTION_UAT_VENDOR_SYSTEM_ID=<vendor-system-id>
HIKCENTRAL_PROJECTION_UAT_PARKING_LOT_INDEX_CODE=<parking-lot-index-code>
HIKCENTRAL_PROJECTION_UAT_PARKING_LOT_NAME=<parking-lot-name>
