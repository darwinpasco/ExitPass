# HikCentral vendor session projection live UAT environment template.
# Copy values into a local shell, deployment secret store, or approved UAT configuration channel.
# Do not commit real HikCentral credentials or local database passwords.

# Central PMS database.
ConnectionStrings__MainDatabase=Host=<postgres-host>;Port=5432;Database=<database>;Username=<username>;Password=<secret>

# Central PMS resolves non-secret, Site-scoped Adapter routes from PostgreSQL.
CentralPms__VendorPms__Provider=SITE_ADAPTER
CentralPms__VendorPms__Environment=UAT
CentralPms__VendorPms__CentralPmsServiceIdentityId=<central-pms-service-identity-uuid>
CentralPms__VendorPms__AdapterSecretMountRoot=/run/secrets/site-adapters
CentralPms__VendorPms__AllowTaskOwnedHttp=false

# Configure these values on one separately deployed Site Integration Adapter, not Central PMS.
SiteAdapter__Activated=true
SiteAdapter__SiteId=<site-uuid>
SiteAdapter__SiteGroupId=<site-group-uuid>
SiteAdapter__VendorSystemId=<vendor-system-uuid>
SiteAdapter__AdapterIdentityId=<adapter-service-identity-uuid>
SiteAdapter__AllowedCentralPmsServiceIdentityId=<central-pms-service-identity-uuid>
SiteAdapter__AdapterEndpointIdentity=<private-adapter-endpoint-identity>
SiteAdapter__Environment=UAT
SiteAdapter__ParkingLotIndexCode=<parking-lot-index-code>
SiteAdapter__HikCentralBaseUrl=https://<site-private-hikcentral-host>
SiteAdapter__SecretMountRoot=/run/secrets/site-adapter
SiteAdapter__HikCentralAppKeyFile=/run/secrets/site-adapter/app-key
SiteAdapter__HikCentralAppSecretFile=/run/secrets/site-adapter/app-secret
SiteAdapter__CentralPmsApiKeyFile=/run/secrets/site-adapter/central-pms-api-key
SiteAdapter__HikCentralUserId=<hikcentral-user-id>
SiteAdapter__HikCentralApiVersion=v3.1.0
SiteAdapter__RequestTimeZoneId=Asia/Manila
SiteAdapter__TimeoutSeconds=30
SiteAdapter__MaxRetries=0
SiteAdapter__AllowTaskOwnedHttp=false

# Projection scheduler UAT flags.
# This UAT template enables the scheduler intentionally. Production defaults remain disabled
# unless the environment explicitly designates one Central PMS scheduler instance.
# Enable only in the UAT process that should run the single centralized scheduler.
CentralPms__VendorSessionProjections__SchedulerEnabled=true
CentralPms__VendorSessionProjections__DefaultPollIntervalSeconds=60
CentralPms__VendorSessionProjections__NormalFreshnessTargetSeconds=60
CentralPms__VendorSessionProjections__DefaultLookbackWindowMinutes=180
CentralPms__VendorSessionProjections__DefaultPageSize=100
CentralPms__VendorSessionProjections__MaxParallelSiteJobs=2
CentralPms__VendorSessionProjections__StartupDelaySeconds=30
CentralPms__VendorSessionProjections__SchedulerScanIntervalSeconds=30
CentralPms__VendorSessionProjections__MaxPagesPerRun=20
CentralPms__VendorSessionProjections__MaxProjectionAgeMinutes=1
CentralPms__VendorSessionProjections__FailingFailureCountThreshold=3

# Keep degraded resolve fallback disabled during scheduler-only UAT unless a separate guarded fallback test is approved.
CentralPms__VendorSessionProjections__DegradedResolveFallbackEnabled=false

# Manual request placeholders; these are not service configuration keys.
EXITPASS_CENTRAL_PMS_BASE_URL=https://<central-pms-host>
HIKCENTRAL_PROJECTION_UAT_SITE_ID=<site-uuid>
HIKCENTRAL_PROJECTION_UAT_SITE_GROUP_ID=<site-group-uuid>
HIKCENTRAL_PROJECTION_UAT_VENDOR_SYSTEM_ID=<vendor-system-uuid>
HIKCENTRAL_PROJECTION_UAT_VENDOR_CODE=<site-vendor-code>
HIKCENTRAL_PROJECTION_UAT_ENVIRONMENT_CODE=UAT
HIKCENTRAL_PROJECTION_UAT_PARKING_LOT_INDEX_CODE=<parking-lot-index-code>
HIKCENTRAL_PROJECTION_UAT_PARKING_LOT_NAME=<parking-lot-name>
HIKCENTRAL_PROJECTION_UAT_SERVICE_IDENTITY_CODE=CENTRAL_PMS_API
