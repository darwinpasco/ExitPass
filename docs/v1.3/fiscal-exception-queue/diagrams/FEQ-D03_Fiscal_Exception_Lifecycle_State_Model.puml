@startuml
title FEQ-D03 Fiscal Exception Lifecycle State Model
skinparam shadowing false

[*] --> detected
detected --> queued
queued --> assigned
assigned --> readback_pending
readback_pending --> readback_matched
readback_pending --> readback_not_found
readback_pending --> mismatch_review
readback_pending --> manual_review_required
readback_pending --> blocked_requires_config_fix

readback_matched --> reconciled
readback_not_found --> retry_eligible
retry_eligible --> retry_scheduled
retry_scheduled --> retry_in_progress
retry_in_progress --> retry_succeeded
retry_in_progress --> retry_failed
retry_in_progress --> manual_review_required
retry_succeeded --> reconciled
retry_failed --> readback_pending : confirm outcome before another retry
retry_failed --> blocked_requires_config_fix
retry_failed --> manual_review_required

mismatch_review --> manual_review_required
manual_review_required --> readback_pending : request new readback
manual_review_required --> retry_eligible : approve retry after controls
manual_review_required --> blocked_requires_config_fix
manual_review_required --> reconciled
manual_review_required --> cancelled_superseded

blocked_requires_config_fix --> assigned : corrected and reassigned
reconciled --> closed
cancelled_superseded --> closed
closed --> [*]

state "Candidate lifecycle names;\nfinal enum/table names deferred" as lifecycle_note
@enduml
