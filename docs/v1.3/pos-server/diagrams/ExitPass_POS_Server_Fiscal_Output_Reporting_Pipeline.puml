@startuml
title ExitPass POS Server Fiscal Output and Reporting Pipeline

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 200
skinparam defaultTextAlignment center

database "Canonical fiscal records\nissued documents, fiscal lines,\ncounters, status, audit links" as Canonical #F3FFF3

rectangle "Customer outputs" #F7FAFF {
    component "Sales Invoice" as SI
    component "Printed SI" as Printed
    component "Digital SI URL" as Digital
}

rectangle "Logs and audit" #FFF9E8 {
    database "Electronic Journal" as EJ
    database "POSLog" as POSLog
    database "Fiscal audit records" as Audit
}

rectangle "Reports and exports" #F8F5FF {
    component "X-read" as XRead
    component "Z-read" as ZRead
    component "BIR Sales Summary" as Summary
    component "Annex E reports" as Annex
    component "Fiscal exports" as Exports
}

rectangle "Controlled actions" #FFF3F3 {
    component "Reprints" as Reprints
    component "Void / refund /\ncancel / return\nadjustment documents" as Adjustments
}

Canonical --> SI
SI --> Printed
SI --> Digital
Canonical --> EJ
Canonical --> POSLog
Canonical --> Audit
Canonical --> XRead
Canonical --> ZRead
Canonical --> Summary
Canonical --> Annex
Canonical --> Exports
Canonical --> Reprints
Canonical --> Adjustments
Reprints --> Audit
Adjustments --> Audit

note bottom of Canonical
Printed and digital outputs must reconcile
to the same canonical fiscal facts as EJ,
POSLog, reports, exports, and audit.
end note

@enduml
